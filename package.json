{
  "name": "centralu",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.17.0",
  "scripts": {
    "build": "vite build --config apps/web/vite.config.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint .",
    "depcruise": "depcruise packages apps --config tooling/dependency-cruiser.cjs",
    "verify": "pnpm lint && pnpm depcruise && pnpm typecheck && pnpm test",
    "dev": "pnpm --filter @cc/web dev",
    "e2e": "playwright test --config e2e/playwright.config.ts",
    "perf": "PERF=1 playwright test perf- --config e2e/playwright.config.ts --workers=1",
    "host": "tsx packages/agent-host/src/main.ts",
    "verify:all": "pnpm verify && pnpm e2e",
    "smoke": "node packages/agent-host/scripts/smoke.mjs",
    "smoke:resume": "node packages/agent-host/scripts/smoke-resume.mjs",
    "bundle:host": "node packages/agent-host/scripts/bundle.mjs",
    "codex:bindings": "node packages/agent-host/scripts/codex-bindings.mjs",
    "smoke:codex": "node packages/agent-host/scripts/smoke-codex.mjs",
    "smoke:orchestrator": "tsx packages/agent-host/scripts/smoke-orchestrator.mts",
    "smoke:schemas": "tsx packages/agent-host/scripts/smoke-schemas.mts",
    "app": "pnpm --filter @cc/desktop exec tauri build && open \"apps/desktop/src-tauri/target/release/bundle/macos/Centralu.app\"",
    "app:open": "open \"apps/desktop/src-tauri/target/release/bundle/macos/Centralu.app\"",
    "app:dev": "pnpm --filter @cc/desktop exec tauri dev",
    "smoke:question": "node --import tsx packages/agent-host/scripts/smoke-question.mts"
  },
  "devDependencies": {
    "@eslint/js": "^9.20.0",
    "@playwright/test": "^1.62.1",
    "@types/node": "^22.13.0",
    "dependency-cruiser": "^16.9.0",
    "eslint": "^9.20.0",
    "eslint-plugin-boundaries": "^5.0.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.11.0",
    "prettier": "^3.5.0",
    "tsx": "^4.23.12",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.24.0",
    "vite": "^8.2.1",
    "vitest": "^3.0.5"
  }
}
