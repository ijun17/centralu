{
  "extends": "./tooling/tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "composite": false,
    "declaration": false,
    "declarationMap": false,
    "types": [
      "node",
      "vite/client"
    ],
    "jsx": "react-jsx",
    "lib": [
      "ES2023",
      "DOM",
      "DOM.Iterable"
    ],
    "paths": {
      "@cc/protocol": [
        "./packages/protocol/src/index.ts"
      ],
      "@cc/core": [
        "./packages/core/src/index.ts"
      ],
      "@cc/platform/ports": [
        "./packages/platform/src/ports/index.ts"
      ],
      "@cc/platform/web": [
        "./packages/platform/src/web/index.ts"
      ],
      "@cc/platform/mock": [
        "./packages/platform/src/mock/index.ts"
      ],
      "@cc/ui": [
        "./packages/ui/src/index.ts"
      ],
      "@cc/platform/tauri": [
        "./packages/platform/src/tauri/index.ts"
      ]
    }
  },
  "include": [
    "packages/*/src/**/*",
    "packages/*/scripts/**/*.mts",
    "apps/*/src/**/*",
    "e2e/**/*",
    "tooling/**/*.ts"
  ],
  "exclude": [
    "**/adapters/codex/generated/**"
  ]
}
