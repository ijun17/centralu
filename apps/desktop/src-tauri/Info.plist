<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  App links (M4 E-4) — this app receives `centralu://app?url=…`. The Tauri bundler merges this
  file into the bundle's Info.plist
  (tauri-utils `MacConfig::info_plist`: "Tauri also looks for a Info.plist file in the same directory as the Tauri configuration file").
  There is only one scheme. The OS hands the link over as an Apple Event, and lib.rs's
  `RunEvent::Opened` receives it — this does not use the deep-link plugin.
  tooling/desktop-permissions.test.ts keeps this list honest.
-->
<plist version="1.0">
<dict>
  <key>CFBundleURLTypes</key>
  <array>
    <dict>
      <key>CFBundleURLName</key>
      <string>app.centralu</string>
      <key>CFBundleTypeRole</key>
      <string>Viewer</string>
      <key>CFBundleURLSchemes</key>
      <array>
        <string>centralu</string>
      </array>
    </dict>
  </array>
</dict>
</plist>
