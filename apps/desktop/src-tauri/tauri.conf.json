{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Control Center",
  "version": "0.1.0",
  "identifier": "dev.controlcenter.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://127.0.0.1:5173",
    "beforeDevCommand": "pnpm vite",
    "beforeBuildCommand": "pnpm -w bundle:host && pnpm vite build"
  },
  "app": {
    "windows": [
      {
        "title": "Control Center",
        "width": 1280,
        "height": 840,
        "minWidth": 900,
        "minHeight": 600,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "backgroundColor": "#090909",
        "theme": "Dark",
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ws://127.0.0.1:* http://127.0.0.1:* ipc: http://ipc.localhost; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self'"
    },
    "macOSPrivateApi": true
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "icon": [
      "icons/icon.png"
    ],
    "category": "DeveloperTool",
    "copyright": "",
    "shortDescription": "에이전트 관제탑",
    "longDescription": "여러 에이전트 코딩 도구를 한 창에서 실행·관찰·제어합니다.",
    "resources": [
      "resources/host/**/*"
    ]
  }
}
