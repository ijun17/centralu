{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Centralu",
  "version": "0.1.0-beta.5",
  "identifier": "app.centralu",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://127.0.0.1:5173",
    "beforeDevCommand": "pnpm vite",
    "beforeBuildCommand": "pnpm -w bundle:host && pnpm vite build"
  },
  "app": {
    "windows": [
      {
        "title": "Centralu",
        "width": 1280,
        "height": 840,
        "minWidth": 900,
        "minHeight": 600,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "backgroundColor": "#090909",
        "theme": "Dark",
        "dragDropEnabled": false,
        "trafficLightPosition": {
          "x": 19,
          "y": 12
        }
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ws://127.0.0.1:* http://127.0.0.1:* ipc: http://ipc.localhost; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self'"
    },
    "macOSPrivateApi": true
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "icon": [
      "icons/icon.icns"
    ],
    "category": "DeveloperTool",
    "copyright": "",
    "shortDescription": "Agent control tower",
    "longDescription": "Run, watch and steer several agent coding tools from one window.",
    "resources": [
      "resources/host/**/*"
    ],
    "macOS": {
      "signingIdentity": "-"
    }
  }
}
