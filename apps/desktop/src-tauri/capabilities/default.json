{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Main window, local pages only: our own commands, dragging, notifications, global shortcuts, dialogs, opening files",
  "windows": [
    "main"
  ],
  "local": true,
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "core:window:allow-set-focus",
    "core:window:allow-show",
    "core:window:allow-unminimize",
    "notification:default",
    "global-shortcut:allow-register",
    "global-shortcut:allow-unregister",
    "global-shortcut:allow-is-registered",
    "dialog:default",
    "opener:default",
    "allow-host-info",
    "allow-host-error",
    "allow-set-badge",
    "allow-alert",
    "allow-open-in-ide",
    "allow-reveal-path",
    "allow-trash-path",
    "allow-file-manager-name",
    "allow-focus-window",
    "allow-window-controls-inset",
    "allow-shortcut-keys",
    "allow-quit-app"
  ]
}
