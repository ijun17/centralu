{
  "owner": "ijun17",
  "number": 1,
  "repository": "ijun17/centralu",
  "fields": { "status": "Status", "priority": "Priority", "area": "Area" },
  "decisionStatus": "Needs decision",
  "cacheSeconds": 30,
  "rules": {
    "prTemplate": ".github/PULL_REQUEST_TEMPLATE.md",
    "commitConventions": "docs/commit-conventions.md"
  },
  "ci": {
    "workflows": [".github/workflows/build.yml"],
    "knownFailuresIssue": 368,
    "waitMinutes": 40,
    "pollSeconds": 30,
    "fullTier": "full tier",
    "landTier": "quick"
  },
  "queue": {
    "batch": { "min": 1, "max": 4 },
    "flakyJobs": [],
    "conflicts": {
      "mechanical": [
        { "files": ["pnpm-lock.yaml"], "run": [["pnpm", "install", "--lockfile-only", "--ignore-scripts"]] },
        { "files": ["docs/generated/schema.md"], "run": [["pnpm", "install", "--frozen-lockfile", "--ignore-scripts"], ["pnpm", "docs:schema"]] },
        {
          "files": ["packages/agent-host/src/dev-services/store-migrations*.golden.json"],
          "run": [["pnpm", "install", "--frozen-lockfile", "--ignore-scripts"], ["pnpm", "exec", "vitest", "run", "--update", "packages/agent-host/src/dev-services/store-migrations.test.ts"]]
        },
        {
          "files": ["apps/desktop/src-tauri/permissions/autogenerated/*.toml"],
          "run": [["pnpm", "install", "--frozen-lockfile", "--ignore-scripts"], ["pnpm", "bundle:host"], ["cargo", "check", "--manifest-path", "apps/desktop/src-tauri/Cargo.toml"]]
        }
      ],
      "never": [
        "e2e/ux/baseline.json",
        "packages/agent-host/src/dev-services/store/migrations/*.ts",
        "packages/agent-host/src/dev-services/store/migrate-runner.ts"
      ],
      "timeoutMinutes": 30
    }
  },
  "release": {
    "source": { "path": "packages/protocol/src/brand.ts", "pattern": "^export const APP_VERSION = '([^']+)'" },
    "versionFiles": [
      "packages/protocol/src/brand.ts",
      "apps/desktop/package.json",
      "apps/desktop/src-tauri/tauri.conf.json",
      "apps/desktop/src-tauri/Cargo.toml",
      "apps/desktop/src-tauri/Cargo.lock",
      "packaging/npm/*/package.json"
    ],
    "ignore": [
      "docs/**/*.md",
      "**/CHANGELOG*",
      "**/release-notes/**/*.md",
      "**/pnpm-lock.yaml",
      "**/package-lock.json",
      "**/npm-shrinkwrap.json",
      "**/*.lock",
      "tooling/project-board-release.test.ts"
    ],
    "tagPrefix": "v",
    "branchPrefix": "chore/release-",
    "workflow": ".github/workflows/release.yml",
    "rehearsalInputs": { "dry_run": "true" },
    "environment": "npm-publish",
    "registry": { "packages": ["packaging/npm/*/package.json"], "shim": "packaging/npm/centralu/package.json" }
  }
}
